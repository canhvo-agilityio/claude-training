{
  "name": "e2e-buddy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @e2e-buddy/server --filter @e2e-buddy/web dev",
    "build": "pnpm --filter @e2e-buddy/web build && pnpm --filter @e2e-buddy/server build",
    "start": "pnpm --filter @e2e-buddy/server start",
    "test": "vitest run --configLoader runner",
    "lint": "eslint . && prettier --check . && pnpm typecheck",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
